extends: default

rules:
  # Workflows do not start with "---" by convention.
  document-start: disable
  # So that every generated file has the same indentation.
  indentation:
    spaces: @indentSize@
  # So that every generated file has the same maximum line length.
  line-length:
    max: @lineLength@
  # Workflows use the "on" key for their triggers.
  truthy:
    check-keys: false
