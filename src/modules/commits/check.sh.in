# Replace refs could show other commits in place of those of the history, and grafts other
# parents.
# Git advises against a graft file each time it reads one, even an empty one.
export GIT_NO_REPLACE_OBJECTS=1
export GIT_GRAFT_FILE=/dev/null
export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=advice.graftFileDeprecated GIT_CONFIG_VALUE_0=false
base=${1:-origin/main}
head=${2:-HEAD}
shallow=$(git rev-parse --is-shallow-repository)
if [ "$shallow" = true ]; then
  echo "the clone is shallow, so it may hide commits: fetch them with git fetch --unshallow" >&2
  exit 1
fi
for ref in "$base" "$head"; do
  if ! git rev-parse --verify --quiet "$ref^{commit}" >/dev/null; then
    echo "$ref is not a commit of the clone: fetch it, or give the base and head as arguments" \
      >&2
    exit 1
  fi
done
# A format of a commit, without the check of its signature that log.showSignature would print.
show() {
  git log -1 --no-show-signature --format="$1" "$2"
}
status=0
# Each commit, followed by its parents.
history=$(git rev-list --parents "$base..$head")
while read -r -a parents; do
  if [ "${#parents[@]}" -eq 0 ]; then
    continue
  fi
  commit=${parents[0]}
  for parent in "${parents[@]:2}"; do
    if ! git merge-base --is-ancestor "$parent" "$base"; then
      echo "$(show '%h %s' "$commit"): merges another branch than $base" >&2
      status=1
    fi
  done
  author=$(show '%an <%ae>' "$commit")
  signoffs=$(show '%(trailers:key=Signed-off-by,valueonly,unfold)' "$commit")
  # Whole lines compared, so that an author on several lines matches none.
  signed=false
  while IFS= read -r signoff; do
    if [ "$signoff" = "$author" ]; then
      signed=true
    fi
  done <<<"$signoffs"
  if ! "$signed"; then
    echo "$(show '%h %s' "$commit"): no Signed-off-by: $author" >&2
    status=1
  fi
done <<<"$history"
exit "$status"
