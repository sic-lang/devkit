base=${1:-origin/main}
head=${2:-HEAD}
for ref in "$base" "$head"; do
  if ! git rev-parse --verify --quiet "$ref^{commit}" >/dev/null; then
    echo "$ref is not a commit of the clone: fetch it, or give the base and head as arguments" \
      >&2
    exit 1
  fi
done
status=0
merges=$(git rev-list --merges "$base..$head")
for commit in $merges; do
  line=$(git log -1 --format='%P' "$commit")
  read -r -a parents <<<"$line"
  for parent in "${parents[@]:1}"; do
    if ! git merge-base --is-ancestor "$parent" "$base"; then
      echo "$(git log -1 --format='%h %s' "$commit"): merges another branch than $base" >&2
      status=1
    fi
  done
done
commits=$(git rev-list "$base..$head")
for commit in $commits; do
  author=$(git log -1 --format='%an <%ae>' "$commit")
  signoffs=$(git log -1 --format='%(trailers:key=Signed-off-by,valueonly)' "$commit")
  if ! grep -qxF "$author" <<<"$signoffs"; then
    echo "$(git log -1 --format='%h %s' "$commit"): no Signed-off-by: $author" >&2
    status=1
  fi
done
exit "$status"
