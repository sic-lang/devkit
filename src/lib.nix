# The values that devkit shares between repositories, so that each has one source.
{
  # The maximum line length of every generated file that has one, even when it equals the tool's
  # default, so that every generated file wraps at the same length.
  lineLength = 100;
  # The number of spaces of each indentation level of every generated file and tool that has one,
  # even when it equals the tool's default, so that every file indents alike.
  indentSize = 2;
  # The license of every repository's own files, so that their code can move between repositories
  # without a change of license.
  license = "Apache-2.0 WITH LLVM-exception";
  # The holder of the copyright of every repository's own files.
  # The contributors keep their copyright, so no single person or company holds it.
  copyrightHolder = "The Sic Contributors";
}
